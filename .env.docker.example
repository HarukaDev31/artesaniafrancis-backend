# Backend Docker — frontend en Netlify
# cp .env.docker.example .env.docker
# docker compose up -d --build

APP_NAME="Artesania Francis"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.artesaniafrancis.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=artesania_francis
DB_USERNAME=artesania
# Debe coincidir con MYSQL_PASSWORD (abajo). Si cambias la clave tras el primer deploy, usa: docker compose down -v
DB_PASSWORD=secret

CACHE_STORE=redis
CACHE_PREFIX=artesania_cache_
CATALOG_CACHE_TTL=3600

SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=s3
FILAMENT_FILESYSTEM_DISK=s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=livewire-tmp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=artesania-francis
AWS_URL=https://cdn.artesaniafrancis.com
AWS_USE_PATH_STYLE_ENDPOINT=false

CDN_URL=https://cdn.artesaniafrancis.com

# CORS — orígenes del frontend en Netlify
FRONTEND_URL=https://www.artesaniafrancis.com
FRONTEND_URL_PROD=https://artesaniafrancis.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS=contacto@artesaniafrancis.com
MAIL_FROM_NAME="${APP_NAME}"

# Docker Compose — MySQL (host puerto 3310)
MYSQL_ROOT_PASSWORD=secret_root
MYSQL_DATABASE=artesania_francis
MYSQL_USER=artesania
MYSQL_PASSWORD=secret
